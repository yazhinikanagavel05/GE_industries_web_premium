# ====================================================================
# GE Industries — Environment Configuration Example
# Gym Equipment Manufacturing E-Commerce
# ====================================================================

# Application Environment
VITE_APP_ENV=development
VITE_SITE_URL=http://localhost:5173

# Supabase Configuration (Optional - Local mock fallback active by default)
# To connect to your Supabase PostgreSQL instance:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Payment Gateway Configuration (Optional - Demo test checkout active by default)
# For real Razorpay Test Mode:
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Note: Razorpay Key Secret must ONLY be used in backend/serverless environments, never in client code!

# Admin Credentials (For frontend demo authentication)
VITE_ADMIN_DEFAULT_EMAIL=admin@geindustries.com
VITE_ADMIN_DEFAULT_PASSWORD=GEAdmin2026!
